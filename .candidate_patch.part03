diff --git a/osf-project-metadata.json b/osf-project-metadata.json
new file mode 100644
index 0000000000000000000000000000000000000000..ab215443e04a56e6c753adec201e72f577dbe202
--- /dev/null
+++ b/osf-project-metadata.json
@@ -0,0 +1,22 @@
+{
+  "title": "Protocolo y decisiones analíticas del Visor Integrado de Democracia del Perú 2020–2030",
+  "description": "Complemento documental del software de investigación preservado en Zenodo. Reúne protocolo, decisiones analíticas, trazabilidad, elicitación de parámetros y materiales bibliográficos no ejecutables. El objeto ejecutable y sus releases citables permanecen en GitHub y Zenodo.",
+  "category": "project",
+  "public": false,
+  "creator": {
+    "name": "Magdiel Torres Vanegas",
+    "orcid": "https://orcid.org/0000-0002-7913-214X",
+    "affiliation": "Universidad Nacional de Trujillo, Escuela de Posgrado – Unidad de Posgrado en Ciencias Económicas; Estudios Axial, Perú"
+  },
+  "related_identifiers": [
+    {
+      "relation": "IsSupplementTo",
+      "identifier": "https://doi.org/10.5281/zenodo.22080540"
+    },
+    {
+      "relation": "IsSupplementTo",
+      "identifier": "https://github.com/vanegasmagdiel/visor-democracia-peru-2020-2030"
+    }
+  ],
+  "version_policy": "OSF preserves protocol and non-executable decisions; Zenodo remains the primary archived software object."
+}
